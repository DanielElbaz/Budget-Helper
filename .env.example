# Copy this file to .env.local and fill in your own Supabase project values.
# See README.md "Configuration Supabase" for the full walkthrough.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Email of the single shared Supabase Auth account you create for the couple.
# Its password is the "access code" typed on the login screen.
VITE_SHARED_ACCOUNT_EMAIL=famille@budget-helper.local
